{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/glm-5.3-flash-free",
  "agents": {
    "title": {
      "model": "opencode/glm-5.3-flash-free"
    },
    "summary": {
      "model": "opencode/glm-5.3-flash-free"
    },
    "compaction": {
      "model": "opencode/glm-5.3-flash-free"
    }
  },
  "providers": {
    "openrouter": {
      "models": {
        "inclusionai/ling-3.2-flash:free": {
          "name": "inclusionAI: Ling 3.2 Flash (free)",
