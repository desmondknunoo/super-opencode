              "image/png",
              "image/jpeg",
              "image/gif",
              "image/webp"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1048576,
            "output": 262144
          }
        },
        "baidu/ernie-5.5-flash-preview:free": {
          "name": "Baidu: ERNIE-5.5-Flash-Preview (free)",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1024000,
            "output": 921600
          }
        },
        "dots-studio/dots-3-note-preview:free": {
          "name": "Dots Studio: Dots3-Note Preview (free)",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image/png",
              "image/jpeg",
              "image/gif",
              "image/webp"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 512000,
            "output": 460800
